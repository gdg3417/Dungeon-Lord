:root {
    --space: 8px;
    --panel: rgb(21, 29, 40);
    --ink: rgb(236, 242, 249);
    --button: rgb(48, 67, 87);
}
.safe-root { position: absolute; flex-direction: column; color: var(--ink); }
.top-chrome, .bottom-chrome { background-color: var(--panel); padding: var(--space); flex-shrink: 1; }
.top-chrome { max-height: 40%; }
.bottom-chrome { max-height: 45%; }
.constructing .bottom-chrome { max-height: 58%; }
.constructing .top-chrome { max-height: 22%; flex-grow: 0; }
.constructing .metric { flex-basis: 22%; }
.capacity-bar { background-color: var(--panel); padding-left: var(--space); padding-right: var(--space); flex-shrink: 0; }
.landscape.constructing .capacity-bar { width: 54%; }
.placement-context { flex-shrink: 0; }
.placement-actions { flex-shrink: 0; padding-bottom: var(--space); }
.placement-actions Button { flex-grow: 1; }
#confirmPlacement { background-color: rgb(35, 89, 81); border-color: rgb(127, 213, 227); }
.session-actions { border-top-width: 1px; border-top-color: rgb(105, 135, 159); padding-top: var(--space); }
#draftSummary { flex-basis: 100%; }
.affordability { color: rgb(255, 190, 139); }
.placement-options { flex-shrink: 0; }
#constructionOptions .row { flex-wrap: nowrap; flex-shrink: 0; }
#constructionSummary { -unity-font-style: bold; }
.landscape.constructing .top-chrome, .landscape.constructing .viewport { width: 54%; }
.landscape.constructing .top-chrome { max-height: 48%; }
.landscape.constructing .bottom-chrome { position: absolute; right: 0; top: 0; bottom: 0; width: 46%; max-height: 100%; }
.landscape.constructing .legacy { align-self: flex-start; }
.context-details { flex-shrink: 1; min-height: 0; overflow: hidden; }
.context-details Label { flex-shrink: 0; }
.bottom-chrome > .row { flex-shrink: 0; }
#status { flex-shrink: 0; }
.category-row { flex-direction: row; align-items: center; flex-shrink: 0; }
.category-strip { flex-grow: 1; flex-shrink: 1; }
.room-card { min-width: 150px; max-width: 210px; }
.viewport { flex-grow: 1; flex-shrink: 1; }
.hud { flex-direction: row; flex-wrap: wrap; }
.metric { flex-basis: 45%; flex-grow: 1; }
.landscape .metric { flex-basis: 22%; }
.row { flex-direction: row; flex-wrap: wrap; align-items: center; }
.floor-scroll { flex-grow: 1; flex-shrink: 1; }
.sheet { display: none; background-color: var(--button); padding: var(--space); }
.mode { -unity-font-style: bold; }
Label { white-space: normal; flex-shrink: 1; }
Button { white-space: normal; flex-shrink: 1; margin: 2px; padding: var(--space); background-color: var(--button); color: var(--ink); border-width: 1px; border-color: rgb(105, 135, 159); }
Button:disabled { color: rgb(160, 170, 184); background-color: rgb(35, 44, 56); }
.selected-floor { border-width: 2px; border-color: rgb(127, 213, 227); }
.legacy { align-self: flex-end; }
.modal { display: none; position: absolute; left: 0; right: 0; top: 0; bottom: 0; background-color: rgba(6, 11, 17, 0.96); justify-content: center; padding: var(--space); }
.modal-content { background-color: var(--panel); padding: var(--space); max-height: 100%; }
